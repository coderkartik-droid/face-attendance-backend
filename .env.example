# Copy this file to .env and fill in real values
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — default is PostgreSQL. Set DB_ENGINE=sqlite to run without a
# PostgreSQL server (for local development / automated tests).
DB_ENGINE=postgresql
DB_NAME=face_attendance_db
DB_USER=face_admin
DB_PASSWORD=strong_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Face recognition
FACE_MATCH_THRESHOLD=0.45

# Force HTTPS redirects (opt-in). Keep False for API clients to avoid 301s.
SECURE_SSL_REDIRECT=False

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:8000
